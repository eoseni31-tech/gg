# Copy to .env.local, fill in your own values, and never commit .env.local.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
APP_ORIGIN=https://YOUR-COUPLE-PROJECT.vercel.app
GUEST_ORIGIN=https://YOUR-GUEST-PROJECT.vercel.app
CODE_PEPPER=
PUBLIC_PROXY_SECRET=
# Local setup only; password is hashed into the database by npm run db:setup.
COUPLE_PASSWORD=
COUPLE_EMAIL=
# Optional owner account for managing multiple couples. Set both or omit both.
ADMIN_ACCESS_CODE=
ADMIN_PASSWORD=
ADMIN_EMAIL=
